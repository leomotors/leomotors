{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["GH_PAT"],
  "tasks": {
    "load": {
      "outputs": ["data/**"],
      "cache": false
    },
    "analyze": {
      "dependsOn": ["load"],
      "outputs": ["out/**"]
    },
    "post-analyze": {
      "dependsOn": ["analyze"],
      "cache": false
    },
    "typecheck": {}
  }
}
