{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!apps/github-stats",
      "!**/*.md",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
