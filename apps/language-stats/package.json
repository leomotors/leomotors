{
  "name": "@leomotors/language-stats",
  "version": "3.0.0",
  "description": "Get Summary of Your Language Stats",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "load": "mkdir -p data && node --env-file-if-exists=../../.env src/loadData.ts",
    "analyze": "mkdir -p out && node src/analyze.js",
    "post-analyze": "bash post-analyze.bash"
  }
}
